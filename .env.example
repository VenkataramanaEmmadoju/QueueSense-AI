# ==============================================================================
# QueueSense AI — Environment Variables Template
# Copy this file to .env or .env.local for local overrides.
# Do NOT commit actual API keys, production tokens, or secrets to Git.
# ==============================================================================

# Application Branding & Metadata
VITE_APP_NAME="QueueSense AI"
VITE_APP_TAGLINE="Smart Hospital Queues, Better Care"
VITE_APP_VERSION="1.0.0"

# Prototype & Mock Simulation Controls
# When set to true, the frontend operates in standalone prototype mode with synthetic data
VITE_USE_MOCK_DATA="true"
VITE_ENABLE_ANALYTICS_SIMULATION="true"

# Future Backend Integration (FastAPI & PostgreSQL / Supabase)
# Leave commented or default until the backend services are deployed
# VITE_API_BASE_URL="http://localhost:8000/api/v1"
# VITE_WS_URL="ws://localhost:8000/ws"

# Supabase Configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Geographic & Localization Defaults
VITE_DEFAULT_LANGUAGE="en"
VITE_DEFAULT_STATE="Telangana"
VITE_DEFAULT_DISTRICT="Rangareddy"
